---
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import Container from "../components/common/Container.astro";
import Breadcrumbs from "../components/common/Breadcrumbs.astro";
import BlogCard from "../components/content/BlogCard.astro";
import TableOfContents from "../components/blog/TableOfContents.astro";
import CodeBlocks from "../components/blog/CodeBlocks.astro";
import RelatedCourse from "../components/blog/RelatedCourse.astro";
import HelpfulVote from "../components/blog/HelpfulVote.astro";
import ShareLinks from "../components/blog/ShareLinks.astro";
import Comments from "../components/blog/Comments.astro";
import { formatDate, slugify } from "../utils/content";

interface Props {
  post: CollectionEntry<"blog">;
  headings: MarkdownHeading[];
  readingTime: string;
  canonical: string;
  editUrl?: string;
  related: CollectionEntry<"blog">[];
  previous?: CollectionEntry<"blog">;
  next?: CollectionEntry<"blog">;
}

const { post, headings, readingTime, canonical, editUrl, related, previous, next } = Astro.props;
const { title, description, category, tags, author, pubDate, updatedDate, image, imageAlt = "", relatedCourse, comments } = post.data;
const hasToc = headings.filter((h) => h.depth === 2 || h.depth === 3).length >= 2;
---

<Container className="py-8 sm:py-12">
  <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Blog", href: "/blog.html" }, { label: title }]} />

  <div class:list={["lg:grid lg:gap-12", hasToc && "lg:grid-cols-[minmax(0,1fr)_15rem]"]}>
    <article class="min-w-0 max-w-3xl">
      <header class="mb-8">
        <a href={`/categories/${slugify(category)}.html`} class="eyebrow inline-block py-1 no-underline hover:no-underline">{category}</a>
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-ink sm:text-4xl">{title}</h1>
        <p class="mt-4 text-lg text-ink-soft">{description}</p>

        <p class="mt-5 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted">
          <span>By <a href="/about.html" class="inline-block py-1 font-medium text-ink-soft">{author}</a></span>
          <span aria-hidden="true">·</span>
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          {updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span>Updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></span>
            </>
          )}
          <span aria-hidden="true">·</span>
          <span>{readingTime}</span>
        </p>

        {tags.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-2" aria-label="Tags">
            {tags.map((tag) => (
              <li>
                <a
                  href={`/tags/${slugify(tag)}.html`}
                  class="inline-flex min-h-8 items-center rounded-full border border-border bg-surface-muted px-3 text-xs font-medium text-ink-soft no-underline hover:border-primary-border hover:text-primary hover:no-underline"
                >
                  #{tag}
                </a>
              </li>
            ))}
          </ul>
        )}
      </header>

      {image && <img src={image} alt={imageAlt} class="mb-8 w-full rounded-card border border-border bg-surface p-2" width="1600" height="900" />}

      <div class="lg:hidden">
        <TableOfContents headings={headings} variant="inline" />
      </div>

      <div class="prose-content">
        <slot />
      </div>

      {relatedCourse && <RelatedCourse course={relatedCourse} slug={post.id} />}

      <HelpfulVote slug={post.id} />

      <ShareLinks url={canonical} title={title} slug={post.id} editUrl={editUrl} />

      {(previous || next) && (
        <nav aria-label="More posts" class="mt-8 grid gap-4 sm:grid-cols-2" data-pagefind-ignore>
          <div>
            {previous && (
              <a class="card block h-full p-4 no-underline hover:no-underline" href={`/blog/${previous.id}.html`}>
                <span class="block text-xs font-semibold uppercase tracking-wide text-muted">← Newer</span>
                <span class="mt-1 block font-medium text-ink">{previous.data.title}</span>
              </a>
            )}
          </div>
          <div class="sm:text-right">
            {next && (
              <a class="card block h-full p-4 no-underline hover:no-underline" href={`/blog/${next.id}.html`}>
                <span class="block text-xs font-semibold uppercase tracking-wide text-muted">Older →</span>
                <span class="mt-1 block font-medium text-ink">{next.data.title}</span>
              </a>
            )}
          </div>
        </nav>
      )}

      {related.length > 0 && (
        <section class="mt-12" aria-labelledby="related-heading" data-pagefind-ignore>
          <h2 id="related-heading" class="mb-4 text-xl font-semibold text-ink">Related posts</h2>
          <div class="grid gap-4 md:grid-cols-2">
            {related.map((item) => <BlogCard post={item} />)}
          </div>
        </section>
      )}

      {comments && <Comments term={post.id} />}
    </article>

    {hasToc && (
      <aside class="hidden lg:block">
        <div class="sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto">
          <TableOfContents headings={headings} variant="sidebar" />
        </div>
      </aside>
    )}
  </div>
</Container>

<CodeBlocks />

<script>
  // Highlight the table-of-contents entry for the section currently on screen.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")].map((link) => [link.dataset.tocLink ?? "", link]),
  );
  if (links.size && "IntersectionObserver" in window) {
    const visible = new Set<string>();
    const headings = [...links.keys()].map((id) => document.getElementById(id)).filter((h): h is HTMLElement => !!h);
    const update = () => {
      const current = headings.find((h) => visible.has(h.id)) ?? null;
      for (const [id, link] of links) link.setAttribute("aria-current", String(current?.id === id));
    };
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) entry.isIntersecting ? visible.add(entry.target.id) : visible.delete(entry.target.id);
        update();
      },
      { rootMargin: "-80px 0px -60% 0px" },
    );
    headings.forEach((h) => observer.observe(h));
  }
</script>
