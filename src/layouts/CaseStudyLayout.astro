---
import ContentLayout from "./ContentLayout.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  caseStudy: CollectionEntry<"caseStudies">;
}

const { caseStudy } = Astro.props;
---

<ContentLayout
  breadcrumbs={[{ label: "Home", href: "/" }, { label: "Case Studies", href: "/case-studies.html" }, { label: caseStudy.data.title }]}
  title={caseStudy.data.title}
  description={caseStudy.data.description}
  pubDate={caseStudy.data.pubDate}
  updatedDate={caseStudy.data.updatedDate}
  heroImage={caseStudy.data.image}
  heroImageAlt={caseStudy.data.imageAlt}
  tags={caseStudy.data.technologies}
>
  <section class="card mb-8 p-5">
    <h2 class="text-xl font-semibold text-slate-950">Executive summary</h2>
    <p class="mt-3 text-slate-600">{caseStudy.data.description}</p>
    <dl class="mt-4 grid gap-3 sm:grid-cols-2">
      <div>
        <dt class="text-sm text-slate-500">Client type</dt>
        <dd class="text-slate-700">{caseStudy.data.clientType ?? "Not specified"}</dd>
      </div>
      <div>
        <dt class="text-sm text-slate-500">Industry</dt>
        <dd class="text-slate-700">{caseStudy.data.industry ?? "Not specified"}</dd>
      </div>
    </dl>
  </section>

  <section>
    <h2>Challenge</h2>
    <p>{caseStudy.data.challenge}</p>
    <h2>Solution</h2>
    <p>{caseStudy.data.solution}</p>
    <h2>Outcome</h2>
    <p>{caseStudy.data.outcome}</p>
  </section>

  <section class="mt-10">
    <article class="card p-4">
      <h3 class="font-semibold text-slate-950">Technologies</h3>
      <ul class="mt-2 space-y-2 text-sm text-slate-600">
        {caseStudy.data.technologies.map((tech: string) => <li>{tech}</li>)}
      </ul>
    </article>
  </section>

  <slot />
</ContentLayout>
