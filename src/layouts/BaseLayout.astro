---
import "../styles/global.css";
import Header from "../components/common/Header.astro";
import Footer from "../components/common/Footer.astro";
import SEOHead from "../components/common/SEOHead.astro";
import { siteGraph } from "../lib/seo/schema";

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  noindex?: boolean;
  type?: "website" | "article" | "video.other";
}

const { title, description, canonicalUrl, ogImage, noindex = false, type = "website" } = Astro.props;

---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead title={title} description={description} canonicalUrl={canonicalUrl} ogImage={ogImage} noindex={noindex} type={type} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="DevOps4Solutions RSS" href="/rss.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(siteGraph())}></script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main-content" data-pagefind-body={noindex ? undefined : ""}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
