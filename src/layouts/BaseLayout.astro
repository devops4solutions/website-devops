---
import "@fontsource-variable/inter/wght.css";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import "../styles/global.css";
import Header from "../components/common/Header.astro";
import Footer from "../components/common/Footer.astro";
import SEOHead from "../components/common/SEOHead.astro";
import Analytics from "../components/common/Analytics.astro";

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  noindex?: boolean;
  type?: "website" | "article" | "video.other";
  /** Pagefind search filter value for this page (shown as a filter in the search dialog). */
  searchType?: "Blog" | "Case study" | "Video" | "Page";
}

const { title, description, canonicalUrl, ogImage, noindex = false, type = "website", searchType = "Page" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead title={title} description={description} canonicalUrl={canonicalUrl} ogImage={ogImage} noindex={noindex} type={type} />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="DevOps4Solutions RSS" href="/rss.xml" />
    <Analytics />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main-content" data-pagefind-body={noindex ? undefined : ""}>
      {!noindex && <span data-pagefind-filter={`type:${searchType}`} hidden></span>}
      <slot />
    </main>
    <Footer />
    <script>
      // Elements with data-track-event send an analytics custom event when clicked.
      import { track } from "../lib/analytics/track";
      document.addEventListener("click", (event) => {
        const el = (event.target as Element | null)?.closest?.<HTMLElement>("[data-track-event]");
        if (!el?.dataset.trackEvent) return;
        const { trackEvent, trackLocation, trackPost } = el.dataset;
        track(trackEvent, {
          page: location.pathname,
          ...(trackLocation ? { location: trackLocation } : {}),
          ...(trackPost ? { post: trackPost } : {}),
        });
      });
    </script>
  </body>
</html>
