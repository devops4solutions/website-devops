---
// Shared view for paginated post lists: the blog index and tag pages.
import type { CollectionEntry } from "astro:content";
import Container from "../common/Container.astro";
import Breadcrumbs from "../common/Breadcrumbs.astro";
import Pagination from "../common/Pagination.astro";
import BlogCard from "../content/BlogCard.astro";
import { slugify } from "../../utils/content";
import { tagCounts } from "../../lib/content/blog";

interface Props {
  heading: string;
  intro?: string;
  breadcrumbs?: { label: string; href?: string }[];
  posts: CollectionEntry<"blog">[];
  /** Every published post, for the category and tag sidebar. */
  allPosts: CollectionEntry<"blog">[];
  currentPage: number;
  lastPage: number;
  urlFor: (page: number) => string;
}

const { heading, intro, breadcrumbs, posts, allPosts, currentPage, lastPage, urlFor } = Astro.props;
const categories = [...new Set(allPosts.map((post) => post.data.category))].sort();
const tags = tagCounts(allPosts).slice(0, 20);
---

<Container className="py-10 sm:py-14">
  {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
  <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">
    {heading}{currentPage > 1 && <span class="text-muted"> · Page {currentPage}</span>}
  </h1>
  {intro && <p class="mt-3 max-w-2xl text-ink-soft">{intro}</p>}

  <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
    <section aria-label="Posts">
      {posts.length === 0 ? (
        <p class="text-ink-soft">No posts yet.</p>
      ) : (
        <div class="grid gap-4 md:grid-cols-2">
          {posts.map((post) => <BlogCard post={post} headingLevel="h2" />)}
        </div>
      )}
      <Pagination currentPage={currentPage} lastPage={lastPage} urlFor={urlFor} label={`${heading} pages`} />
    </section>

    <aside class="space-y-6" data-pagefind-ignore>
      <a
        href="/search.html"
        data-search-open
        class="flex min-h-11 items-center gap-3 rounded-card border border-border bg-surface px-4 text-sm text-muted no-underline shadow-card hover:border-primary-border hover:no-underline"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        Search articles, case studies and videos…
      </a>

      <section class="card p-5">
        <h2 class="text-base font-semibold text-ink">Categories</h2>
        <ul class="mt-2 text-sm">
          {categories.map((category) => (
            <li><a class="inline-block py-1.5" href={`/categories/${slugify(category)}.html`}>{category}</a></li>
          ))}
        </ul>
      </section>

      <section class="card p-5">
        <div class="flex items-baseline justify-between gap-2">
          <h2 class="text-base font-semibold text-ink">Tags</h2>
          <a href="/tags.html" class="inline-block py-1 text-sm">All tags →</a>
        </div>
        <ul class="mt-3 flex flex-wrap gap-2 text-sm">
          {tags.map(({ tag, slug, count }) => (
            <li>
              <a
                class="inline-flex min-h-8 items-center gap-1 rounded-full border border-border px-3 text-ink-soft no-underline hover:border-primary-border hover:text-primary hover:no-underline"
                href={`/tags/${slug}.html`}
              >
                {tag} <span class="text-xs text-muted">{count}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </aside>
  </div>
</Container>
