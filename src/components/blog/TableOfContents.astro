---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
  /** "sidebar": sticky list on wide screens. "inline": collapsible box above the post on phones/tablets. */
  variant: "sidebar" | "inline";
}

const { headings, variant } = Astro.props;
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{items.length >= 2 && (
  variant === "sidebar" ? (
    <nav aria-label="On this page" class="toc text-sm" data-pagefind-ignore>
      <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-muted">On this page</p>
      <ul class="space-y-1 border-l border-border">
        {items.map((heading) => (
          <li>
            <a
              href={`#${heading.slug}`}
              data-toc-link={heading.slug}
              class:list={[
                "-ml-px block border-l-2 border-transparent py-1.5 pr-2 text-ink-soft no-underline hover:border-primary-border hover:text-primary hover:no-underline aria-[current=true]:border-primary aria-[current=true]:font-medium aria-[current=true]:text-primary",
                heading.depth === 3 ? "pl-7" : "pl-4",
              ]}
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  ) : (
    <details class="toc-inline mb-8 rounded-card border border-border bg-surface-muted" data-pagefind-ignore>
      <summary class="flex min-h-11 cursor-pointer items-center justify-between px-4 text-sm font-semibold text-ink">
        On this page
        <span aria-hidden="true" class="text-muted">{items.length} sections</span>
      </summary>
      <nav aria-label="On this page" class="border-t border-border px-2 py-2">
        <ul>
          {items.map((heading) => (
            <li>
              <a
                href={`#${heading.slug}`}
                class:list={[
                  "block rounded-md py-2 pr-2 text-sm text-ink-soft no-underline hover:bg-surface hover:text-primary hover:no-underline",
                  heading.depth === 3 ? "pl-6" : "pl-2",
                ]}
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  )
)}
