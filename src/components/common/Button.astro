---
interface Props {
  href?: string;
  variant?: "primary" | "secondary";
  size?: "sm" | "md";
  type?: "button" | "submit";
  ariaLabel?: string;
  class?: string;
  /** Analytics custom event sent on click (see BaseLayout), e.g. "Book a call". */
  trackEvent?: string;
  trackLocation?: string;
}
const { href, variant = "primary", size = "md", type = "button", ariaLabel, class: className = "", trackEvent, trackLocation } = Astro.props;

const base =
  "inline-flex items-center justify-center rounded-full font-semibold no-underline transition hover:no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus";
const sizes = {
  sm: "px-4 py-1.5 text-sm",
  md: "px-5 py-2.5 text-sm",
};
const variants = {
  primary: "bg-primary text-white shadow-sm hover:bg-primary-hover hover:text-white",
  secondary: "border border-primary-border bg-surface text-primary hover:border-primary hover:bg-primary-soft hover:text-primary-hover",
};
const classes = `${base} ${sizes[size]} ${variants[variant]} ${className}`;
---

{
  href ? (
    <a href={href} class={classes} aria-label={ariaLabel} data-track-event={trackEvent} data-track-location={trackLocation}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} aria-label={ariaLabel} data-track-event={trackEvent} data-track-location={trackLocation}>
      <slot />
    </button>
  )
}
