---
import Container from "./Container.astro";
import MobileMenu from "./MobileMenu.astro";
import Button from "./Button.astro";
import { bookCallLink, headerNav, siteConfig, visibleLinks } from "../../config/site";

const links = visibleLinks(headerNav);
const currentPath = Astro.url.pathname;
// /blog.html is active on /blog.html and on /blog/<post>.html
const isActive = (href: string) => currentPath === href || currentPath.startsWith(href.replace(/\.html$/, "/"));
---

<header class="sticky top-0 z-40 border-b border-primary-border/60 bg-primary-soft/90 backdrop-blur" data-pagefind-ignore>
  <Container>
    <div class="flex h-16 items-center justify-between gap-3">
      <a href="/" class="flex min-w-0 flex-col leading-tight no-underline hover:no-underline">
        <span class="truncate text-xl font-bold tracking-tight text-brand-navy min-[400px]:text-2xl sm:text-[1.75rem]">{siteConfig.name}</span>
        <span class="truncate text-xs font-medium text-ink-soft">{siteConfig.tagline}</span>
      </a>

      <nav aria-label="Primary" class="hidden lg:block">
        <ul class="flex items-center gap-1">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? "page" : undefined}
                class="rounded-md px-3 py-1.5 text-base font-semibold text-ink-soft no-underline transition-colors hover:bg-surface/90 hover:text-ink hover:no-underline aria-[current=page]:text-primary"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="flex shrink-0 items-center gap-2">
        <a
          href="/search.html"
          aria-label="Search"
          class="inline-flex size-11 shrink-0 items-center justify-center rounded-full border border-primary-border bg-surface text-primary transition hover:border-primary hover:text-primary-hover sm:size-10"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5"></path>
          </svg>
        </a>
        <!-- On phones the call-to-action lives in the menu, so the header never overflows. -->
        <div class="hidden sm:block">
          <Button href={bookCallLink.href} size="sm" class="whitespace-nowrap">{bookCallLink.label}</Button>
        </div>
        <MobileMenu links={links} currentPath={currentPath} />
      </div>
    </div>
  </Container>
</header>
