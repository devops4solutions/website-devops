---
import Button from "./Button.astro";
import { bookCallLink, type NavLink } from "../../config/site";

interface Props {
  links: NavLink[];
  currentPath: string;
}

const { links, currentPath } = Astro.props;
---

<details class="mobile-menu relative lg:hidden">
  <summary
    class="flex h-11 cursor-pointer list-none items-center gap-2 rounded-full border border-border bg-surface px-3.5 text-sm font-medium text-ink-soft sm:h-10 [&::-webkit-details-marker]:hidden"
    aria-label="Menu"
  >
    <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M4 7h16M4 12h16M4 17h16"></path>
    </svg>
    <span>Menu</span>
  </summary>
  <nav
    aria-label="Mobile"
    class="absolute right-0 top-full mt-3 w-[min(18rem,calc(100vw-2rem))] rounded-card border border-border bg-surface p-3 shadow-lg shadow-slate-200/60"
  >
    <ul class="space-y-1">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={currentPath === link.href ? "page" : undefined}
            class="block rounded-lg px-3 py-3 font-medium text-ink no-underline hover:bg-surface-muted hover:text-primary hover:no-underline aria-[current=page]:text-primary"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="mt-3 border-t border-border pt-3">
      <Button href={bookCallLink.href} class="w-full" trackEvent="Book a call" trackLocation="mobile menu">{bookCallLink.label}</Button>
    </div>
  </nav>
</details>

<script>
  // Close the menu on Escape or when clicking outside it.
  const menu = document.querySelector<HTMLDetailsElement>("details.mobile-menu");
  if (menu) {
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.open) {
        menu.open = false;
        menu.querySelector("summary")?.focus();
      }
    });
    document.addEventListener("click", (event) => {
      if (menu.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    });
  }
</script>
