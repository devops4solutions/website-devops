---
interface Props {
  title: string;
  description?: string;
  align?: "left" | "center";
}
const { title, description, align = "left" } = Astro.props;
---

<header class={`mb-8 ${align === "center" ? "text-center" : ""}`}>
  <h2 class="text-2xl font-semibold tracking-tight text-slate-950 sm:text-3xl">{title}</h2>
  {description && <p class="mt-3 max-w-3xl text-slate-600">{description}</p>}
</header>
