---
import Container from "./Container.astro";
import { footerNav, siteConfig, visibleLinks } from "../../config/site";

const year = new Date().getFullYear();
const columns = footerNav.map((column) => ({ ...column, links: visibleLinks(column.links) }));
const socials = Object.values(siteConfig.social);
---

<footer class="border-t border-border bg-surface" data-pagefind-ignore>
  <Container className="py-10">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <a href="/" class="inline-block py-1 text-lg font-bold text-brand-navy no-underline hover:no-underline">{siteConfig.name}</a>
        <p class="mt-2 text-sm text-ink-soft">{siteConfig.tagline}</p>
        <p class="mt-3 text-sm">
          <a href={`mailto:${siteConfig.email}`} class="inline-block py-1.5 break-all">{siteConfig.email}</a>
        </p>
      </div>

      {columns.map((column) => (
        <nav aria-label={column.title}>
          <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-muted">{column.title}</p>
          <ul class="space-y-1 text-sm">
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-block py-1.5 text-ink-soft hover:text-primary"
                  target={link.external ? "_blank" : undefined}
                  rel={link.external ? "noreferrer" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="mt-8 flex flex-col gap-4 border-t border-border pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-xs text-muted">© {year} {siteConfig.name}. All rights reserved.</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-1 text-sm" aria-label="Social media">
        {socials.map((profile) => (
          <li>
            <a href={profile.url} class="inline-block py-1.5 text-ink-soft hover:text-primary" target="_blank" rel="noreferrer">{profile.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </Container>
</footer>
