---
import Container from "./Container.astro";
import { siteConfig } from "../../data/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-slate-100 bg-white" data-pagefind-ignore>
  <Container className="py-10">
    <div class="grid gap-8 sm:grid-cols-2 md:grid-cols-4">
      <div>
        <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-slate-400">Services</p>
        <ul class="space-y-2 text-sm">
          {siteConfig.footer.services.map((item) => (
            <li><a href={item.href} class="text-slate-600 hover:text-blue-600">{item.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-slate-400">Content</p>
        <ul class="space-y-2 text-sm">
          {siteConfig.footer.content.map((item) => (
            <li><a href={item.href} class="text-slate-600 hover:text-blue-600" target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noreferrer' : undefined}>{item.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-slate-400">Connect</p>
        <ul class="space-y-2 text-sm">
          <li><a href={siteConfig.youtubeUrl} class="text-slate-600 hover:text-blue-600" target="_blank" rel="noreferrer">YouTube</a></li>
          <li><a href={siteConfig.linkedinUrl} class="text-slate-600 hover:text-blue-600" target="_blank" rel="noreferrer">LinkedIn</a></li>
          <li><a href={siteConfig.instagramUrl} class="text-slate-600 hover:text-blue-600" target="_blank" rel="noreferrer">Instagram</a></li>
          <li><a href="/contact.html" class="text-slate-600 hover:text-blue-600">Contact</a></li>
        </ul>
      </div>
      <div>
        <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-slate-400">Company</p>
        <ul class="space-y-2 text-sm">
          <li><a href="/about.html" class="text-slate-600 hover:text-blue-600">About</a></li>
          <li><a href="/privacy.html" class="text-slate-600 hover:text-blue-600">Privacy</a></li>
        </ul>
      </div>
    </div>
    <p class="mt-8 border-t border-slate-100 pt-6 text-xs text-slate-400">
      © {year} DevOps4Solutions. All rights reserved.
    </p>
  </Container>
</footer>
