---
interface Props {
  before: string;
  after: string;
}
const { before, after } = Astro.props;
---

<section class="my-8 grid gap-4 md:grid-cols-2">
  <div class="card p-4">
    <h3 class="mb-2 font-semibold text-white">Before</h3>
    <pre class="overflow-x-auto text-sm text-slate-300"><code>{before}</code></pre>
  </div>
  <div class="card p-4">
    <h3 class="mb-2 font-semibold text-white">After</h3>
    <pre class="overflow-x-auto text-sm text-slate-300"><code>{after}</code></pre>
  </div>
</section>
