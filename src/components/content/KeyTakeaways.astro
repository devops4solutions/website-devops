---
interface Props {
  items: string[];
}
const { items } = Astro.props;
---

<section class="card my-8 p-6">
  <h3 class="text-lg font-semibold text-slate-950">Key takeaways</h3>
  <ul class="mt-4 space-y-2 text-slate-700">
    {items.map((item) => (
      <li class="flex gap-2"><span aria-hidden="true" class="text-blue-600">•</span>{item}</li>
    ))}
  </ul>
</section>
