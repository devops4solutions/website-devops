---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../../utils/content";
import { readingTime } from "../../lib/content/blog";

interface Props {
  post: CollectionEntry<"blog">;
  headingLevel?: "h2" | "h3";
}

const { post, headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;
---

<!-- The title link is stretched over the whole card, so the card is one large tap target. -->
<article class="card relative flex h-full flex-col p-6">
  <p class="eyebrow">{post.data.category}</p>
  <Heading class="mt-2 text-lg font-semibold text-ink">
    <a href={`/blog/${post.id}.html`} class="text-ink no-underline after:absolute after:inset-0 after:rounded-card after:content-[''] hover:text-primary hover:no-underline">
      {post.data.title}
    </a>
  </Heading>
  <p class="mt-3 text-sm text-ink-soft">{post.data.description}</p>
  <p class="mt-auto pt-4 text-xs text-muted">
    <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time> · {readingTime(post)}
  </p>
  {post.data.tags.length > 0 && (
    <ul class="mt-3 flex flex-wrap gap-2" aria-label="Tags">
      {post.data.tags.map((tag) => (
        <li class="rounded-full border border-border bg-surface-muted px-2 py-1 text-xs text-ink-soft">{tag}</li>
      ))}
    </ul>
  )}
</article>
