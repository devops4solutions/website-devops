---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../../utils/content";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
---

<article class="card h-full p-6">
  <p class="eyebrow">{post.data.category}</p>
  <h3 class="mt-2 text-lg font-semibold text-slate-950">
    <a href={`/blog/${post.id}.html`} class="no-underline hover:text-sky-700">{post.data.title}</a>
  </h3>
  <p class="mt-3 text-sm text-slate-600">{post.data.description}</p>
  <p class="mt-4 text-xs text-slate-500">
    {formatDate(post.data.pubDate)}
    {post.data.readingTime && ` • ${post.data.readingTime}`}
  </p>
  {post.data.tags.length > 0 && (
    <ul class="mt-4 flex flex-wrap gap-2">
      {post.data.tags.map((tag) => (
        <li class="rounded-full border border-slate-200 bg-slate-50 px-2 py-1 text-xs text-slate-600">{tag}</li>
      ))}
    </ul>
  )}
</article>
