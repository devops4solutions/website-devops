---
interface Props {
  title: string;
  tone?: "info" | "warning";
}
const { title, tone = "info" } = Astro.props;
---

<aside class={`my-6 rounded-xl border p-4 ${tone === "warning" ? "border-amber-400/40 bg-amber-500/10" : "border-cyan-400/40 bg-cyan-500/10"}`}>
  <h3 class="font-semibold text-white">{title}</h3>
  <div class="mt-2 text-sm text-slate-200">
    <slot />
  </div>
</aside>
