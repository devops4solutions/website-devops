---
interface Props {
  title: string;
  tone?: "info" | "warning";
}
const { title, tone = "info" } = Astro.props;
---

<aside class={`my-6 rounded-xl border p-4 ${tone === "warning" ? "border-amber-300 bg-amber-50" : "border-blue-200 bg-blue-50"}`}>
  <h3 class="font-semibold text-slate-950">{title}</h3>
  <div class="mt-2 text-sm text-slate-700">
    <slot />
  </div>
</aside>
