---
import type { CollectionEntry } from "astro:content";
import BookButton from "./BookButton.astro";

interface Props {
  session: CollectionEntry<"sessions">;
}

const { session } = Astro.props;
const { title, summary, durationMin, billing, price, includes, bestFor, featured } = session.data;

const formattedPrice = price
  ? new Intl.NumberFormat("en-US", { style: "currency", currency: price.currency, maximumFractionDigits: 0 }).format(price.amount)
  : undefined;
const meta = [durationMin ? `${durationMin} min` : undefined, billing === "monthly" ? "Monthly" : "One-off session"].filter(Boolean);
---

<article
  class:list={[
    "relative flex h-full flex-col rounded-card border bg-surface p-6 shadow-card",
    featured ? "border-primary ring-1 ring-primary" : "border-border",
  ]}
  aria-labelledby={`session-${session.id}`}
>
  {featured && (
    <p class="absolute -top-3 left-6 rounded-full bg-primary px-3 py-0.5 text-xs font-semibold text-white">Most popular</p>
  )}
  <p class="text-xs font-semibold uppercase tracking-wide text-muted">{meta.join(" · ")}</p>
  <h3 id={`session-${session.id}`} class="mt-2 text-xl font-bold text-ink">{title}</h3>
  <p class="mt-3 text-2xl font-bold text-ink">
    {formattedPrice ? (
      <>
        {formattedPrice}
        {billing === "monthly" && <span class="text-base font-medium text-muted"> / month</span>}
      </>
    ) : (
      <span class="text-lg font-semibold text-ink-soft">Price on request</span>
    )}
  </p>
  <p class="mt-3 text-sm text-ink-soft">{summary}</p>
  {includes.length > 0 && (
    <ul class="mt-4 space-y-2 text-sm text-ink-soft">
      {includes.map((item) => (
        <li class="flex gap-2">
          <svg aria-hidden="true" viewBox="0 0 20 20" class="mt-0.5 size-4 shrink-0 text-primary" fill="currentColor">
            <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.8 3.8 6.8-6.8a1 1 0 0 1 1.4 0Z" clip-rule="evenodd"></path>
          </svg>
          {item}
        </li>
      ))}
    </ul>
  )}
  {bestFor && <p class="mt-4 text-sm"><span class="font-semibold text-ink">Best for:</span> <span class="text-ink-soft">{bestFor}</span></p>}
  <div class="mt-auto pt-6">
    <BookButton session={session} variant={featured ? "primary" : "secondary"} />
  </div>
</article>
