---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/common/Container.astro";
import ProjectRequestForm from "../components/hire-me/ProjectRequestForm.astro";
import { features, siteConfig } from "../config/site";

// Guard: never publish the form linked from the navigation without a Web3Forms access key.
if (features.hireMe && !siteConfig.hireMe.web3formsAccessKey) {
  throw new Error("features.hireMe is on but siteConfig.hireMe.web3formsAccessKey is empty (src/config/site.ts).");
}

const live = features.hireMe;

const steps = [
  { title: "Tell me about the project", text: "Share the goal, current setup, budget and timeline using the form below." },
  { title: "Intro call", text: "I review the request and reply with questions or an invitation to a short call." },
  { title: "Proposal", text: "You get a written scope with deliverables, timeline and a fixed price or day rate." },
  { title: "Kick-off", text: "A deposit invoice confirms the start date, then we get to work with regular updates." },
];
---

<BaseLayout
  title="Hire me for a project | DevOps4Solutions"
  description="Request an AWS, Terraform, Kubernetes or CI/CD project: migrations, landing zones, EKS platforms and pipelines delivered by Nidhi Gupta."
  noindex={!live}
>
  <section class="border-b border-border bg-surface py-12 sm:py-16">
    <Container>
      <div class="max-w-3xl">
        <p class="eyebrow mb-3">Projects</p>
        <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-5xl">Hire me for a project</h1>
        <p class="mt-5 text-lg text-ink-soft">
          Fixed-scope delivery for AWS migrations, landing zones, Terraform modules, EKS platforms and CI/CD pipelines, from design through hand-over.
        </p>
      </div>
    </Container>
  </section>

  <section class="py-12 sm:py-16" aria-labelledby="how-heading">
    <Container>
      <h2 id="how-heading" class="text-2xl font-bold text-ink sm:text-3xl">How it works</h2>
      <ol class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {steps.map((step, index) => (
          <li class="rounded-card border border-border bg-surface p-6 shadow-card">
            <span class="inline-flex size-9 items-center justify-center rounded-full bg-primary text-sm font-bold text-white" aria-hidden="true">{index + 1}</span>
            <h3 class="mt-4 text-lg font-semibold text-ink">{step.title}</h3>
            <p class="mt-2 text-sm text-ink-soft">{step.text}</p>
          </li>
        ))}
      </ol>
    </Container>
  </section>

  <section id="request" class="scroll-mt-20 pb-12 sm:pb-16" aria-labelledby="form-heading">
    <Container>
      <div class="grid gap-10 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
        <div class="rounded-card border border-border bg-surface p-5 shadow-card sm:p-8">
          <h2 id="form-heading" class="text-2xl font-bold text-ink">Project details</h2>
          <p class="mt-2 text-sm text-muted">Fields marked <span class="text-red-700">*</span> are required.</p>
          <div class="mt-8">
            <ProjectRequestForm />
          </div>
        </div>

        <aside class="space-y-5">
          <section class="rounded-card border border-border bg-surface p-6 shadow-card" aria-labelledby="payments-heading">
            <h2 id="payments-heading" class="text-lg font-semibold text-ink">How payments work</h2>
            <ul class="mt-3 space-y-2 text-sm text-ink-soft">
              <li>Invoices for deposits and milestones are sent by email from Stripe, with a secure payment link.</li>
              <li>You pay on Stripe's own checkout page. No card details are entered on this website.</li>
              <li>Company details and tax IDs can be added to invoices on request.</li>
            </ul>
            {features.pay && <a href="/pay.html" class="mt-4 inline-block py-1 text-sm font-semibold">Payment options →</a>}
          </section>
          <section class="rounded-card border border-primary-border bg-primary-soft p-6">
            <h2 class="text-lg font-semibold text-ink">Not ready for a project?</h2>
            <p class="mt-2 text-sm text-ink-soft">Start with a paid deep-dive session or a quick intro call.</p>
            <a href={features.consulting ? "/consulting.html" : "/contact.html"} class="mt-3 inline-block py-1 text-sm font-semibold">
              {features.consulting ? "See consulting sessions →" : "Get in touch →"}
            </a>
          </section>
        </aside>
      </div>
    </Container>
  </section>
</BaseLayout>
