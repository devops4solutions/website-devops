---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/common/Container.astro";
---

<BaseLayout title="Page not found | DevOps4Solutions" noindex={true}>
  <Container className="py-20 text-center">
    <h1 class="text-4xl font-semibold text-slate-950">404</h1>
    <p class="mt-3 text-slate-500">The page you requested could not be found.</p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a class="card px-4 py-2" href="/">Home</a>
      <a class="card px-4 py-2" href="/blog.html">Blog</a>
      <a class="card px-4 py-2" href="/case-studies.html">Case Studies</a>
      <a class="card px-4 py-2" href="/videos.html">Videos</a>
    </div>
  </Container>
</BaseLayout>
