---
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CaseStudyLayout from "../../layouts/CaseStudyLayout.astro";
import Container from "../../components/common/Container.astro";
import CaseStudyCard from "../../components/content/CaseStudyCard.astro";
import Button from "../../components/common/Button.astro";
import { getPublishedCaseStudies } from "../../lib/content/queries";
import { articleSchema, breadcrumbSchema } from "../../lib/seo/schema";

export async function getStaticPaths() {
  const caseStudies = await getPublishedCaseStudies();

  return caseStudies.map((item) => ({
    params: { id: item.id },
    props: { caseStudy: item, allCaseStudies: caseStudies },
  }));
}

interface Props {
  caseStudy: CollectionEntry<"caseStudies">;
  allCaseStudies: CollectionEntry<"caseStudies">[];
}

const { caseStudy, allCaseStudies } = Astro.props;
const { Content } = await render(caseStudy);

const related = allCaseStudies
  .filter((item) => item.id !== caseStudy.id)
  .filter((item) =>
    item.data.technologies.some((tech) => caseStudy.data.technologies.includes(tech)),
  )
  .slice(0, 3);

const canonical = new URL(`/case-studies/${caseStudy.id}.html`, Astro.site).toString();
const ogImage = `/og/case-studies/${caseStudy.id}.png`;

const caseStudySchema = articleSchema({
  type: "Article",
  url: canonical,
  title: caseStudy.data.title,
  description: caseStudy.data.description,
  image: ogImage,
  published: caseStudy.data.pubDate,
  modified: caseStudy.data.updatedDate,
  keywords: caseStudy.data.technologies,
  section: "Case Study",
});

const breadcrumbs = breadcrumbSchema([
  { name: "Home", url: new URL("/", Astro.site).toString() },
  { name: "Case Studies", url: new URL("/case-studies.html", Astro.site).toString() },
  { name: caseStudy.data.title, url: canonical },
]);
---

<BaseLayout title={`${caseStudy.data.title} | DevOps4Solutions`} description={caseStudy.data.description} ogImage={ogImage} type="article" searchType="Case study">
  <CaseStudyLayout caseStudy={caseStudy}>
    <Content />
  </CaseStudyLayout>

  {related.length > 0 && (
    <Container className="pb-10">
      <h2 class="mb-4 text-2xl font-semibold text-slate-950">Related case studies</h2>
      <div class="grid gap-4 md:grid-cols-3">
        {related.map((item) => <CaseStudyCard item={item} />)}
      </div>
    </Container>
  )}

  <Container className="pb-16">
    <div class="card p-6 text-center">
      <h2 class="text-2xl font-semibold text-slate-950">Need a similar architecture review?</h2>
      <div class="mt-4"><Button href="/contact.html">Book a Consultation</Button></div>
    </div>
  </Container>
  <script type="application/ld+json" set:html={JSON.stringify(caseStudySchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)}></script>
</BaseLayout>
