---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/common/Container.astro";
import { siteConfig } from "../config/site";

const mailto = `mailto:${siteConfig.email}`;
const socials = Object.values(siteConfig.social);
---

<BaseLayout title="Contact | DevOps4Solutions" description="Contact DevOps4Solutions.">
  <section class="border-b border-slate-200 bg-white py-12">
    <Container>
      <p class="eyebrow mb-2">Get in touch</p>
      <h1 class="text-3xl font-bold text-slate-950 sm:text-4xl">Contact Us</h1>
      <p class="mt-3 text-slate-500">Reach out for architecture reviews, migration planning, or platform engineering support.</p>
    </Container>
  </section>

  <Container className="py-12">
    <div class="grid gap-10 lg:grid-cols-[1fr_320px]">
      <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-semibold text-slate-950">Start a conversation</h2>
        <p class="mt-3 text-slate-600">For architecture reviews, cloud migration, Terraform, Kubernetes, or CI/CD work, email <a href={mailto}>{siteConfig.email}</a>.</p>
      </section>

      <!-- Contact details sidebar -->
      <aside class="space-y-5">
        <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 class="mb-4 text-sm font-semibold uppercase tracking-wide text-muted">Contact details</h2>
          <ul class="space-y-3 text-sm text-slate-700">
            <li><span class="font-medium">Email</span><br/><a href={mailto} class="inline-block py-1 break-all">{siteConfig.email}</a></li>
            {socials.map((profile) => (
              <li><span class="font-medium">{profile.label}</span><br/><a href={profile.url} class="inline-block py-1" target="_blank" rel="noreferrer">{profile.handle}</a></li>
            ))}
          </ul>
        </div>
        <div class="rounded-xl border border-blue-100 bg-blue-50 p-5">
          <p class="text-sm font-semibold text-slate-950">Prefer to browse first?</p>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a href="/services.html" class="inline-block py-1 text-blue-600 hover:underline">View all services →</a></li>
            <li><a href="/case-studies.html" class="inline-block py-1 text-blue-600 hover:underline">Read case studies →</a></li>
            <li><a href="/blog.html" class="inline-block py-1 text-blue-600 hover:underline">Read the blog →</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </Container>
</BaseLayout>
