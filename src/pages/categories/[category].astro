---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentLayout from "../../layouts/ContentLayout.astro";
import BlogCard from "../../components/content/BlogCard.astro";
import { slugify } from "../../utils/content";
import { getPublishedPosts } from "../../lib/content/queries";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  const categories = [...new Set(posts.map((post) => post.data.category))];

  return categories.map((category) => ({
    params: { category: slugify(category) },
    props: { category, posts },
  }));
}

interface Props {
  category: string;
  posts: CollectionEntry<"blog">[];
}

const { category, posts } = Astro.props;

const matches = posts
  .filter((post) => slugify(post.data.category) === slugify(category));
---

<BaseLayout title={`${category} Articles | DevOps4Solutions`} description={`Articles in ${category}.`}>
  <ContentLayout
    breadcrumbs={[{ label: "Home", href: "/" }, { label: "Blog", href: "/blog.html" }, { label: "Categories" }, { label: category }]}
    title={`Category: ${category}`}
    description={`Articles tagged under ${category}.`}
  >
    <div class="grid gap-4 md:grid-cols-2">
      {matches.map((post) => <BlogCard post={post} />)}
    </div>
  </ContentLayout>
</BaseLayout>
