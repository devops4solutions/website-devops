---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/common/Container.astro";
import Breadcrumbs from "../../components/common/Breadcrumbs.astro";
import { getPublishedPosts } from "../../lib/content/queries";
import { tagCounts } from "../../lib/content/blog";

const tags = tagCounts(await getPublishedPosts());
---

<BaseLayout title="Tags | DevOps4Solutions" description="Browse DevOps4Solutions articles by topic: AWS, Terraform, Kubernetes, CI/CD and more.">
  <Container className="py-10 sm:py-14">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Blog", href: "/blog.html" }, { label: "Tags" }]} />
    <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">Tags</h1>
    <p class="mt-3 text-ink-soft">Browse articles by topic.</p>
    <ul class="mt-8 flex flex-wrap gap-3">
      {tags.map(({ tag, slug, count }) => (
        <li>
          <a
            href={`/tags/${slug}.html`}
            class="inline-flex min-h-11 items-center gap-2 rounded-full border border-border bg-surface px-4 text-ink no-underline shadow-card hover:border-primary-border hover:text-primary hover:no-underline"
          >
            #{tag}
            <span class="rounded-full bg-primary-soft px-2 text-xs font-semibold text-primary">{count}</span>
          </a>
        </li>
      ))}
    </ul>
  </Container>
</BaseLayout>
