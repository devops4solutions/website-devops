---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentLayout from "../../layouts/ContentLayout.astro";
import BlogCard from "../../components/content/BlogCard.astro";
import { slugify } from "../../utils/content";

export async function getStaticPaths() {
  const posts = (await getCollection("blog") as CollectionEntry<"blog">[]).filter(
    (post: CollectionEntry<"blog">) => !post.data.draft,
  );

  const tags = [...new Set(posts.flatMap((post: CollectionEntry<"blog">) => post.data.tags))];

  return tags.map((tag: string) => ({
    params: { tag: slugify(tag) },
    props: { tag, posts },
  }));
}

interface Props {
  tag: string;
  posts: CollectionEntry<"blog">[];
}

const { tag, posts } = Astro.props;

const matches = posts
  .filter((post: CollectionEntry<"blog">) => post.data.tags.some((entry: string) => slugify(entry) === slugify(tag)))
  .sort((a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout title={`${tag} Articles | DevOps4Solutions`} description={`Articles tagged ${tag}.`}>
  <ContentLayout
    breadcrumbs={[{ label: "Home", href: "/" }, { label: "Blog", href: "/blog.html" }, { label: "Tags" }, { label: tag }]}
    title={`Tag: ${tag}`}
    description={`Articles matching tag ${tag}.`}
  >
    <div class="grid gap-4 md:grid-cols-2">
      {matches.map((post: CollectionEntry<"blog">) => <BlogCard post={post} />)}
    </div>
  </ContentLayout>
</BaseLayout>
