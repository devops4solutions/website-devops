---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostListing from "../../components/blog/PostListing.astro";
import { getPublishedPosts } from "../../lib/content/queries";
import { pageUrl, paginate, tagCounts } from "../../lib/content/blog";
import { slugify } from "../../utils/content";
import { siteConfig } from "../../config/site";

// Page 1 of each tag at /tags/<tag>.html. Later pages: src/pages/tags/[tag]/page/[page].astro
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return tagCounts(posts).map(({ tag, slug }) => {
    const matches = posts.filter((post) => post.data.tags.some((entry) => slugify(entry) === slug));
    const pages = paginate(matches, siteConfig.postsPerPage);
    return { params: { tag: slug }, props: { tag, pagePosts: pages[0], allPosts: posts, lastPage: pages.length } };
  });
}

interface Props {
  tag: string;
  pagePosts: CollectionEntry<"blog">[];
  allPosts: CollectionEntry<"blog">[];
  lastPage: number;
}

const { tag, pagePosts, allPosts, lastPage } = Astro.props;
const base = `/tags/${Astro.params.tag}`;
---

<BaseLayout title={`${tag} Articles | DevOps4Solutions`} description={`Articles about ${tag} on AWS, DevOps and platform engineering.`}>
  <PostListing
    heading={`#${tag}`}
    intro={`Articles tagged ${tag}.`}
    breadcrumbs={[{ label: "Home", href: "/" }, { label: "Blog", href: "/blog.html" }, { label: "Tags", href: "/tags.html" }, { label: tag }]}
    posts={pagePosts}
    allPosts={allPosts}
    currentPage={1}
    lastPage={lastPage}
    urlFor={(page) => pageUrl(base, page)}
  />
</BaseLayout>
