---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentLayout from "../../layouts/ContentLayout.astro";
import BlogCard from "../../components/content/BlogCard.astro";
import { slugify } from "../../utils/content";
import { getPublishedPosts } from "../../lib/content/queries";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];

  return tags.map((tag) => ({
    params: { tag: slugify(tag) },
    props: { tag, posts },
  }));
}

interface Props {
  tag: string;
  posts: CollectionEntry<"blog">[];
}

const { tag, posts } = Astro.props;

const matches = posts
  .filter((post) => post.data.tags.some((entry) => slugify(entry) === slugify(tag)));
---

<BaseLayout title={`${tag} Articles | DevOps4Solutions`} description={`Articles tagged ${tag}.`}>
  <ContentLayout
    breadcrumbs={[{ label: "Home", href: "/" }, { label: "Blog", href: "/blog.html" }, { label: "Tags" }, { label: tag }]}
    title={`Tag: ${tag}`}
    description={`Articles matching tag ${tag}.`}
  >
    <div class="grid gap-4 md:grid-cols-2">
      {matches.map((post) => <BlogCard post={post} />)}
    </div>
  </ContentLayout>
</BaseLayout>
