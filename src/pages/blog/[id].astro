---
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogPostLayout from "../../layouts/BlogPostLayout.astro";
import { getPublishedPosts } from "../../lib/content/queries";
import { articleSchema, breadcrumbSchema } from "../../lib/seo/schema";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  return posts.map((post, index) => ({
    params: { id: post.id },
    props: {
      post,
      previous: posts[index - 1],
      next: posts[index + 1],
      allPosts: posts,
    },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
  previous?: CollectionEntry<"blog">;
  next?: CollectionEntry<"blog">;
  allPosts: CollectionEntry<"blog">[];
}

const { post, previous, next, allPosts } = Astro.props;
const { Content } = await render(post);

const related = allPosts
  .filter((item) => item.id !== post.id && item.data.tags.some((tag) => post.data.tags.includes(tag)))
  .slice(0, 3);

const canonical = post.data.canonicalUrl ?? new URL(`/blog/${post.id}.html`, Astro.site).toString();

const ogImage = `/og/blog/${post.id}.png`;

const blogPostingSchema = articleSchema({
  type: "BlogPosting",
  url: canonical,
  title: post.data.title,
  description: post.data.description,
  image: ogImage,
  published: post.data.pubDate,
  modified: post.data.updatedDate,
  keywords: post.data.tags,
  section: post.data.category,
});

const breadcrumbs = breadcrumbSchema([
  { name: "Home", url: new URL("/", Astro.site).toString() },
  { name: "Blog", url: new URL("/blog.html", Astro.site).toString() },
  { name: post.data.title, url: canonical },
]);
---

<BaseLayout
  title={`${post.data.title} | DevOps4Solutions`}
  description={post.data.description}
  canonicalUrl={canonical}
  ogImage={ogImage}
  type="article"
>
  <BlogPostLayout post={post} related={related} previous={previous} next={next}>
    <Content />
  </BlogPostLayout>
  <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)}></script>
</BaseLayout>
