---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostListing from "../../../components/blog/PostListing.astro";
import { featuredFirst, getPublishedPosts } from "../../../lib/content/queries";
import { pageUrl, paginate } from "../../../lib/content/blog";
import { siteConfig } from "../../../config/site";

// Blog pages 2..n at /blog/page/<n>.html (page 1 is /blog.html).
export async function getStaticPaths() {
  const posts = (await getPublishedPosts()).sort(featuredFirst);
  const pages = paginate(posts, siteConfig.postsPerPage);
  return pages.slice(1).map((pagePosts, index) => ({
    params: { page: String(index + 2) },
    props: { pagePosts, allPosts: posts, lastPage: pages.length },
  }));
}

interface Props {
  pagePosts: CollectionEntry<"blog">[];
  allPosts: CollectionEntry<"blog">[];
  lastPage: number;
}

const { pagePosts, allPosts, lastPage } = Astro.props;
const currentPage = Number(Astro.params.page);
---

<BaseLayout title={`Blog – Page ${currentPage} | DevOps4Solutions`} description={`Technical blogs on AWS, DevOps, migration, and platform engineering (page ${currentPage}).`}>
  <PostListing
    heading="Blog"
    breadcrumbs={[{ label: "Home", href: "/" }, { label: "Blog", href: "/blog.html" }, { label: `Page ${currentPage}` }]}
    posts={pagePosts}
    allPosts={allPosts}
    currentPage={currentPage}
    lastPage={lastPage}
    urlFor={(page) => pageUrl("/blog", page)}
  />
</BaseLayout>
