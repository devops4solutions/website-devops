---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostListing from "../../components/blog/PostListing.astro";
import { featuredFirst, getPublishedPosts } from "../../lib/content/queries";
import { pageUrl, paginate } from "../../lib/content/blog";
import { siteConfig } from "../../config/site";

// Page 1 of the blog. Later pages: src/pages/blog/page/[page].astro
const posts = (await getPublishedPosts()).sort(featuredFirst);
const pages = paginate(posts, siteConfig.postsPerPage);
---

<BaseLayout title="Blog | DevOps4Solutions" description="Technical blogs on AWS, DevOps, migration, and platform engineering.">
  <PostListing
    heading="Blog"
    intro="Practical AWS, Terraform, Kubernetes and platform engineering guides from real enterprise projects."
    posts={pages[0]}
    allPosts={posts}
    currentPage={1}
    lastPage={pages.length}
    urlFor={(page) => pageUrl("/blog", page)}
  />
</BaseLayout>
