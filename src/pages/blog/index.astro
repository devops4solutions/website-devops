---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/common/Container.astro";
import BlogCard from "../../components/content/BlogCard.astro";
import { slugify } from "../../utils/content";

const posts = (await getCollection("blog") as CollectionEntry<"blog">[])
  .filter((post: CollectionEntry<"blog">) => !post.data.draft)
  .sort((a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) => {
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    return b.data.pubDate.getTime() - a.data.pubDate.getTime();
  });

const categories = [...new Set(posts.map((post: CollectionEntry<"blog">) => post.data.category))].sort();
const tags = [...new Set(posts.flatMap((post: CollectionEntry<"blog">) => post.data.tags))].sort();
---

<BaseLayout title="Blog | DevOps4Solutions" description="Technical blogs on AWS, DevOps, migration, and platform engineering.">
  <Container className="py-14">
    <h1 class="text-3xl font-semibold text-slate-950">Blog</h1>

    <div class="mt-6 grid gap-8 lg:grid-cols-[2fr_1fr]">
      <section>
        <label for="blog-filter" class="block text-sm font-medium text-slate-600">Search this page</label>
        <input id="blog-filter" type="search" placeholder="Filter by title or tag" class="mt-2 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-slate-800" />

        {posts.length === 0 ? (
          <p class="mt-8 text-slate-300">No blog posts are available yet.</p>
        ) : (
          <div id="blog-list" class="mt-6 grid gap-4 md:grid-cols-2">
            {posts.map((post: CollectionEntry<"blog">) => <BlogCard post={post} />)}
          </div>
        )}
      </section>

      <aside class="space-y-6">
        <section class="card p-5">
          <h2 class="text-lg font-semibold text-slate-950">Categories</h2>
          <ul class="mt-3 space-y-2 text-sm">
            {categories.map((category: string) => (
              <li><a href={`/categories/${slugify(category)}.html`}>{category}</a></li>
            ))}
          </ul>
        </section>

        <section class="card p-5">
          <h2 class="text-lg font-semibold text-slate-950">Tags</h2>
          <ul class="mt-3 flex flex-wrap gap-2 text-sm">
            {tags.map((tag: string) => (
              <li><a class="rounded-full border border-slate-200 px-2 py-1 text-slate-600 hover:border-blue-300 hover:text-blue-600" href={`/tags/${slugify(tag)}.html`}>{tag}</a></li>
            ))}
          </ul>
        </section>
      </aside>
    </div>
  </Container>
</BaseLayout>

<script>
  const input = document.querySelector("#blog-filter");
  const cards = Array.from(document.querySelectorAll("#blog-list article"));
  if (input instanceof HTMLInputElement) {
    input.addEventListener("input", () => {
      const term = input.value.toLowerCase().trim();
      cards.forEach((card) => {
        const text = card.textContent?.toLowerCase() ?? "";
        card.toggleAttribute("hidden", term.length > 0 && !text.includes(term));
      });
    });
  }
</script>
