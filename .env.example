# Environment variables for devops4solutions.com
#
# Copy to .env (local dev) and fill in only what the current phase needs.
# Never commit .env. In production, set these in the host's dashboard or secret store.
#
# Naming rules (Astro):
#   PUBLIC_*  is embedded in browser JavaScript. Only put non-secret values here.
#   Anything else is server-only (available to /api/* routes, never sent to the browser).
#
# Phase 0 (current static site) needs NONE of these. The site builds without a .env file.
# Site name, author, social links and the contact email live in src/config/site.ts, not here.

# =============================================================================
# Phase 0 follow-up: video metadata import (optional, local script only)
# =============================================================================

# YouTube Data API v3 key. Used once by a script to replace the 131 placeholder
# video titles and descriptions. Create it in Google Cloud Console → APIs & Services → Credentials.
YOUTUBE_API_KEY=

# =============================================================================
# Phase 1: consulting, project requests, blog features, analytics
# =============================================================================

# Absolute site URL, used in emails and redirects from API routes.
PUBLIC_SITE_URL=https://devops4solutions.com

# --- Cloudflare Turnstile (spam protection on the project-request form) -------
# Cloudflare dashboard → Turnstile → Add widget.
# The site key is public (rendered in the form); the secret verifies tokens on the server.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Transactional email (project-request notifications and auto-replies) -----
# Resend: resend.com → API Keys. The sending domain needs SPF/DKIM records.
RESEND_API_KEY=
# Sender address on your verified domain, e.g. "DevOps4Solutions <hello@devops4solutions.com>".
MAIL_FROM=
# Where new project requests are delivered (your inbox).
MAIL_TO_OWNER=

# --- Attachment storage (project-request uploads via short-lived signed URLs) --
# Cloudflare R2 (S3-compatible API). R2 → Manage API tokens → Object Read & Write, scoped to one bucket.
# Keep the bucket private; the email to you contains time-limited download links.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=project-request-uploads

# --- Cal.com (consulting bookings) ------------------------------------------
# No variables needed: Cal.com event links and prices are public and live in
# src/data/sessions.yaml. Payment is configured in Cal.com (Apps → Stripe).

# --- Analytics (privacy-friendly, cookieless). Fill in ONE provider. ------------
# Loaded in production builds only (`npm run build`), never in `npm run dev`.
# Plausible: the domain as registered in Plausible. Change the script URL only if you self-host.
PUBLIC_PLAUSIBLE_DOMAIN=
PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js
# Umami: website ID and script URL (cloud: https://cloud.umami.is/script.js, or your self-hosted instance).
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_SCRIPT_URL=

# --- Giscus comments (GitHub Discussions) ------------------------------------
# Generate these at giscus.app after enabling Discussions on a public repo.
# Comments render only when all four are set; leave them empty to hide comments everywhere.
# A single post can opt out with `comments: false` in its frontmatter.
PUBLIC_GISCUS_REPO=devops4solutions/website-devops
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=Comments
PUBLIC_GISCUS_CATEGORY_ID=

# Stripe and Razorpay Payment Links for /pay.html are public URLs: they live in
# src/config/site.ts, not here. No payment secrets are needed before Phase 3.

# =============================================================================
# Phase 2: learning hub (external course platform)
# =============================================================================

# Bunny Stream library ID, only if course videos are hosted on Bunny instead of YouTube.
# Public embeds need only the library ID; signed playback (Phase 3) also needs the token key below.
PUBLIC_BUNNY_STREAM_LIBRARY_ID=

# Mux, only if course videos are hosted on Mux. Public playback IDs live in content files;
# these API credentials are used by scripts that look up assets.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# =============================================================================
# Phase 3: database, accounts, webhooks, on-site payments
# =============================================================================

# --- Postgres (Neon or Supabase) ---------------------------------------------
# Pooled connection string. On Cloudflare Workers use Neon's HTTP driver or a Hyperdrive binding.
DATABASE_URL=

# --- Auth (Better Auth) ------------------------------------------------------
# Random 32+ byte secret for signing sessions: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Base URL the auth routes are served from.
BETTER_AUTH_URL=https://devops4solutions.com
# Optional OAuth sign-in providers.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe (webhooks and on-site Checkout) ----------------------------------
# Dashboard → Developers → API keys. Use a restricted key with only the permissions the routes need.
STRIPE_SECRET_KEY=
# Dashboard → Developers → Webhooks → endpoint /api/webhooks/stripe → Signing secret.
STRIPE_WEBHOOK_SECRET=

# --- Cal.com webhooks ---------------------------------------------------------
# Cal.com → Settings → Developer → Webhooks → endpoint /api/webhooks/cal → Secret.
CAL_WEBHOOK_SECRET=

# --- Razorpay (only if UPI payments move on-site) ------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Signed video playback for paid lessons (pick the provider in use) ---------
BUNNY_STREAM_TOKEN_KEY=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=

# --- Newsletter (deferred; only if added later) --------------------------------
NEWSLETTER_API_KEY=
NEWSLETTER_LIST_ID=

# =============================================================================
# CI / deployment (set as GitHub Actions secrets, not in .env)
# =============================================================================

# Cloudflare: My Profile → API Tokens → "Edit Cloudflare Workers" template.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
