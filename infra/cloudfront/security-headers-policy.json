{
  "Name": "devops4solutions-security-headers",
  "Comment": "Security headers for devops4solutions.com. The full Content-Security-Policy (script/style hashes, Cal.com, Stripe, Web3Forms, Giscus, YouTube, analytics) ships per page as a <meta> tag generated by Astro (security.csp in astro.config.mjs); this header adds the directives a <meta> tag cannot set.",
  "SecurityHeadersConfig": {
    "StrictTransportSecurity": {
      "Override": true,
      "AccessControlMaxAgeSec": 31536000,
      "IncludeSubdomains": true,
      "Preload": false
    },
    "ContentTypeOptions": {
      "Override": true
    },
    "FrameOptions": {
      "Override": true,
      "FrameOption": "SAMEORIGIN"
    },
    "ReferrerPolicy": {
      "Override": true,
      "ReferrerPolicy": "strict-origin-when-cross-origin"
    },
    "ContentSecurityPolicy": {
      "Override": true,
      "ContentSecurityPolicy": "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
    }
  },
  "CustomHeadersConfig": {
    "Quantity": 1,
    "Items": [
      {
        "Header": "Permissions-Policy",
        "Value": "camera=(), microphone=(), geolocation=(), usb=()",
        "Override": true
      }
    ]
  }
}
